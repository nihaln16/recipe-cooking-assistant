# Copy to .env and fill in locally. Never commit real secrets.
# Do not paste API keys into chat.

SESSION_SECRET=change-me-to-a-long-random-string
DATA_DIR=.
SESSION_TTL_HOURS=24
MAX_IMAGES=6
MAX_UPLOAD_BYTES=4194304

# Required for extraction (milestone 2+). Set privately in this file or your host env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# In-memory cooking-guidance caps for this process. A restart clears them.
GUIDANCE_LIMIT_PER_SESSION=20
GUIDANCE_LIMIT_PER_PROCESS=60
GUIDANCE_LIMIT_WINDOW_SECONDS=3600
